# Docker image build/push config (tracked in git).
# Edit VERSION when cutting a new release; "latest" will point to this.
IMAGE=darknetz/php-rand
TAG=latest
VERSION=v1.4.0

# Publish: GitLab CI (.gitlab-ci.yml) on gitlab01 is primary.
# Local fallback (GitHub Actions Docker workflows unused):
#   ./docker-pushimage.sh --dev       # rolling :dev + :develop
#   ./docker-pushimage.sh             # release :latest + :vX.Y.Z (+ stripped)
#   ./docker-pushimage.sh --dry-run
# One build → all enabled registries (Hub + GHCR); partial failure aborts.

# GitHub Container Registry. CI uses GITHUB_TOKEN variable; locally .env / .env.local.
GHCR_IMAGE=ghcr.io/darknetzz/php-rand
